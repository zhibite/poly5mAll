# ---------------------------------------------------------------------------
# 06.poly5mAll — 7-asset 5m rebound strategy
#
# Copy to .env and fill in only what you need.  Paper mode needs no
# credentials.  Live mode requires BOTH PAPER_TRADING=false and
# LIVE_ENABLED=true, plus valid CLOB credentials below.
# ---------------------------------------------------------------------------

# ── Trading mode ────────────────────────────────────────────────────────────
# Paper is the safe default.  Live is refused unless both flags say live.
PAPER_TRADING=true
LIVE_ENABLED=false

# ── Universe / strategy overrides (optional) ───────────────────────────────
# TRADE_ASSETS=BTC,ETH,BNB,SOL,DOGE,XRP,HYPE
# STAKE_USD=2
# TAKER_FEE_RATE=0.07
# observed = FAK at target floor, fills at best bid (recommended)
# market   = trigger on mid, marketable FAK below bid (can fill below target)
# TP_EXECUTION_MODE=observed
# Entry liquidity and correlation limits.
# REQUIRE_TWO_SIDED_BOOK=true
# MIN_ENTRY_BID_DEPTH_USD=5
# MAX_SAME_SIDE_POSITIONS=3
# MAX_DAILY_LOSS_USD=0
# PAUSE_NEW_ENTRIES=false
# FLATTEN_ON_EXIT=false

# ── CLOB credentials (live only) ───────────────────────────────────────────
# WALLET_PRIVATE_KEY is ALWAYS required for order signing.  If the L2 API
# credentials below are empty, they are derived from the key at startup.
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=

# Optional L2 API credentials (recommended for faster startup).
API_KEY=
API_SECRET=
API_PASSPHRASE=

# 0 = EOA, 1 = POLY_PROXY, 2 = GNOSIS_SAFE.
SIGNATURE_TYPE=0
# Wallet that actually holds the funds (required for signature types 1/2).
FUNDER_ADDRESS=

# ── Endpoints ───────────────────────────────────────────────────────────────
POLYMARKET_HOST=https://clob.polymarket.com
GAMMA_API=https://gamma-api.polymarket.com

# ── Web backend ─────────────────────────────────────────────────────────────
# Dashboard + JSON API.  Set WEB_PASSWORD to enable HTTP Basic auth.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8033
WEB_USERNAME=admin
WEB_PASSWORD=
WEB_SESSION_TTL_S=604800

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
