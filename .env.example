# ---------------------------------------------------------------------------
# 06.poly5mAll — 6-coin rebound strategy (5m on by default; 15m opt-in)
#
# Copy to .env and fill in only what you need.  Paper mode needs no
# credentials.  Live mode requires BOTH PAPER_TRADING=false and
# LIVE_ENABLED=true, plus valid CLOB credentials below.
# ---------------------------------------------------------------------------

# ── Trading mode ────────────────────────────────────────────────────────────
# Paper is the safe default.  Live is refused unless both flags say live.
PAPER_TRADING=true
LIVE_ENABLED=false

# ── Universe / strategy overrides (optional) ───────────────────────────────
# Coins (both timeframes are configured independently in config.toml).
# TRADE_ASSETS=BTC,ETH,BNB,SOL,DOGE,XRP,HYPE
# Timeframes to load; default is 5m only.  15m is opt-in: run it alone
# with TRADE_INTERVALS=15m, or enable individual markets on /config.
# TRADE_INTERVALS=5m
# STAKE_USD=2
# Default taker fee for markets without an override.  Current official
# crypto schedule: BTC = 0.05, every other asset = 0.01.  Per-coin
# overrides: BTC_TAKER_FEE_RATE, ETH_TAKER_FEE_RATE, ...; per-market
# overrides: ETH_15M_TAKER_FEE_RATE, ...
# Per-market strategy overrides use {ASSET}_{INTERVAL}_<FIELD>, e.g.
# ETH_15M_ENTRY_THRESH=0.20, ETH_15M_TP_PCT=0.20, ETH_15M_STOP_LOSS_PCT=0.25.
# The coin-level ETH_ENTRY_THRESH sets both timeframes.
# TAKER_FEE_RATE=0.01
# observed = FAK at target floor, fills at best bid (recommended)
# market   = trigger on mid, marketable FAK below bid (can fill below target)
# TP_EXECUTION_MODE=observed
# Per-market price stop, armed from the fill (0=off): e.g. 0.5 = -50%.
# BNB_STOP_LOSS_PCT=0.5 applies to BNB 5m and 15m; BNB_15M_STOP_LOSS_PCT
# overrides the 15m market only.
# Entry liquidity and correlation limits.
# REQUIRE_TWO_SIDED_BOOK=true
# MIN_ENTRY_BID_DEPTH_USD=5
# MAX_SPREAD_ABS=0.01
# MAX_SAME_SIDE_POSITIONS=6
# Global concurrent exposure across both timeframes and all markets
# (open positions + in-flight entries; 0=off).
# MAX_OPEN_POSITIONS=6
# MAX_OPEN_NOTIONAL_USD=10
# Correlated-risk cap: at most this many same-side entries per market
# window (5m and 15m counted separately).
# MAX_SAME_SIDE_PER_WINDOW=2
# Stop new entries after this UTC-day realized loss (0=off).
# MAX_DAILY_LOSS_USD=40
# Pause new entries after this UTC-day drawdown from the intraday peak.
# The pause lasts INTRADAY_DRAWDOWN_PAUSE_MIN minutes (60 or 120), then
# resumes with a rebased drawdown anchor (0=off).
# MAX_INTRADAY_DRAWDOWN_USD=16
# INTRADAY_DRAWDOWN_PAUSE_MIN=60
# Per-market-window total exposure across both sides and all markets;
# 5m and 15m windows are counted separately (0=off).
# MAX_POSITIONS_PER_WINDOW=3
# MAX_WINDOW_NOTIONAL_USD=6
# Per-asset rolling performance de-risking over trades.jsonl (0 = off).
# At/below MIN_PNL the stake is multiplied by STAKE_MULT; at/below
# DISABLE_PNL the coin stops entering.
# ASSET_PERF_LOOKBACK_DAYS=7
# ASSET_PERF_MIN_PNL_USD=-3
# ASSET_PERF_STAKE_MULT=0.5
# ASSET_PERF_DISABLE_PNL_USD=-6
# PAUSE_NEW_ENTRIES=false
# FLATTEN_ON_EXIT=false

# ── CLOB credentials (live only) ───────────────────────────────────────────
# WALLET_PRIVATE_KEY is ALWAYS required for order signing.  If the L2 API
# credentials below are empty, they are derived from the key at startup.
WALLET_PRIVATE_KEY=
WALLET_ADDRESS=

# Optional L2 API credentials (recommended for faster startup).
API_KEY=
API_SECRET=
API_PASSPHRASE=

# 0 = EOA, 1 = POLY_PROXY, 2 = GNOSIS_SAFE.
SIGNATURE_TYPE=0
# Wallet that actually holds the funds (required for signature types 1/2).
FUNDER_ADDRESS=

# ── Endpoints ───────────────────────────────────────────────────────────────
POLYMARKET_HOST=https://clob.polymarket.com
GAMMA_API=https://gamma-api.polymarket.com

# ── Web backend ─────────────────────────────────────────────────────────────
# Dashboard + JSON API.  Set WEB_PASSWORD to enable HTTP Basic auth.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8033
WEB_USERNAME=admin
WEB_PASSWORD=
WEB_SESSION_TTL_S=604800

# ── Feed / WebSocket ────────────────────────────────────────────────────────
# 7 independent CLOB WS shards; REST /book fallback every 3 s.
# WS_SHARDS=7
# BOOK_POLL_S=3.0

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
